#!name=YouTube 集中增强 · 可莉去广告版
#!desc=可莉原脚本处理 YouTube 去广告与字幕。独立翻译 Music 歌词，并在兼容的播放请求中优先选高画质。
#!author=Maasea, gholts, RuCu6, VirgilClyne, Kelee; integration for Veyrn
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/YouTube.png
#!system=iOS, iPadOS
#!loon_version=3.5.1(998)
#!date=2026-11-16 1.0.3
#!tag=去广告,功能增强

[Argument]
autoHd=switch, true, tag=优先高画质, desc=使用 RuCu6 画质偏好处理兼容的播放请求
captionLang=select, "zh-Hans", "zh-Hant", "en", "ja", "ko", "off", tag=YouTube 字幕语言
musicTranslate=switch, true, tag=Music 歌词翻译
musicLang=select, "ZH-HANS", "ZH-HANT", "EN", "JA", "KO", tag=Music 歌词语言
musicShowOnly=switch, false, tag=Music 只显示译文
musicPosition=select, "Forward", "Reverse", tag=Music 原文位置
blockUpload=switch, false, tag=隐藏上传按钮
blockShorts=switch, false, tag=隐藏 Shorts 按钮
blockImmersive=switch, false, tag=隐藏 Music 选段按钮
debug=switch, false, tag=调试日志

[Rule]
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN,music.youtube.com),(PROTOCOL,QUIC)),REJECT

[Script]
request if ${url} ~= /^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&ack.*/i then script("https://kelee.one/Resource/JavaScript/YouTube/YouTube_remove_ads/YouTube_remove_ads_request.js", {${captionLang}}) with tag="可莉 · 播放初始化", requires_body=true, binary_body_mode=true, timeout=20
request if ${url} ~= /^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event(?:\?.*)?$/i then script("https://kelee.one/Resource/JavaScript/YouTube/YouTube_remove_ads/YouTube_remove_ads_request.js", {${blockUpload}, ${blockShorts}, ${blockImmersive}, ${captionLang}, ${debug}}) with tag="可莉 · 日志请求", requires_body=true, binary_body_mode=true, timeout=20
response if ${url} ~= /^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(?:browse(?!\?(?:[^#]*&)?ytunified=music(?:&|$))|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config)(?:\?.*)?$/i then script("https://kelee.one/Resource/JavaScript/YouTube/YouTube_remove_ads/YouTube_remove_ads_response.js", {${blockUpload}, ${blockShorts}, ${blockImmersive}, ${captionLang}, ${debug}}) with tag="可莉 · 去广告与字幕", requires_body=true, binary_body_mode=true, timeout=20
request if ${url} ~= /^https?:\/\/[\w-]+\.googlevideo\.com\/videoplayback(?:\?.*)?$/i then script("https://raw.githubusercontent.com/GeQainZz/Clash-Modules/youtube-clash-compat/Loon/YouTube-Unified/YouTube-Unified.js?v=1.0.2", {${autoHd}, ${debug}}) with tag="YouTube · 优先高画质", requires_body=true, binary_body_mode=true, enable=${autoHd}, timeout=20
request if ${url} ~= /^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/browse(?:\?.*)?$/i then script("https://raw.githubusercontent.com/GeQainZz/Clash-Modules/youtube-clash-compat/Loon/YouTube-Unified/YouTube-Unified.js?v=1.0.2", {${musicTranslate}, ${musicLang}, ${musicShowOnly}, ${musicPosition}, ${debug}}) with tag="Music · 歌词标记", requires_body=true, binary_body_mode=true, enable=${musicTranslate}, timeout=20
request if ${url} ~= /^https:\/\/music\.youtube\.com\/youtubei\/v1\/browse(?:\?.*)?$/i then script("https://raw.githubusercontent.com/GeQainZz/Clash-Modules/youtube-clash-compat/Loon/YouTube-Unified/YouTube-Unified.js?v=1.0.2", {${musicTranslate}, ${musicLang}, ${musicShowOnly}, ${musicPosition}, ${debug}}) with tag="Music 网页 · 歌词标记", requires_body=true, enable=${musicTranslate}, timeout=20
response if ${url} ~= /^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/browse\?(?:[^#]*&)?ytunified=music(?:&[^#]*)?$/i then script("https://raw.githubusercontent.com/GeQainZz/Clash-Modules/youtube-clash-compat/Loon/YouTube-Unified/YouTube-Unified.js?v=1.0.2", {${musicTranslate}, ${musicLang}, ${musicShowOnly}, ${musicPosition}, ${debug}}) with tag="Music · 歌词翻译", requires_body=true, binary_body_mode=true, enable=${musicTranslate}, timeout=25
response if ${url} ~= /^https:\/\/music\.youtube\.com\/youtubei\/v1\/browse\?(?:[^#]*&)?ytunified=music(?:&[^#]*)?$/i then script("https://raw.githubusercontent.com/GeQainZz/Clash-Modules/youtube-clash-compat/Loon/YouTube-Unified/YouTube-Unified.js?v=1.0.2", {${musicTranslate}, ${musicLang}, ${musicShowOnly}, ${musicPosition}, ${debug}}) with tag="Music 网页 · 歌词翻译", requires_body=true, enable=${musicTranslate}, timeout=25

[MITM]
hostname=*.googlevideo.com, youtubei.googleapis.com, music.youtube.com
